<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Meta 광고 어트리뷰션 도입(NM-465)으로 **추적을 하게 됐다.**
         전환 신호를 Meta 에 넘기면 Meta 가 자기 크로스-앱 프로필과 결합하므로 애플 기준 '추적'이다.
         (~2026-09 에는 false 였다 — 그때는 Firebase Analytics 뿐이라 앱 밖으로 나가는 결합이 없었다.)

         도메인은 FBSDKCoreKit 이 자체 매니페스트에 선언한 값을 그대로 쓴다.
         빠뜨리면 런타임에 연결이 차단된다. -->
    <key>NSPrivacyTracking</key>
    <true/>
    <key>NSPrivacyTrackingDomains</key>
    <array>
        <string>ep1.facebook.com</string>
    </array>

    <!-- 앱이 수집하는 데이터 유형. App Store Connect '개인정보 영양성분표'와 일치시켜야 함.
         Firebase Analytics(제품 상호작용)·Crashlytics(크래시) 기준 (NM-458: Amplitude 제거, 지표는 Firebase 단독).
         기기 UUID 항목은 NM-410 잔재로 남아 있다 — 앱은 더 이상 수집하지 않으므로 정리 대상. -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!-- 앱 이벤트 = 제품 상호작용.
             Firebase(분석) + Meta 로 보내는 가입 전환(광고). 후자가 추적에 해당하므로 Tracking=true 다
             — 한 데이터 유형에 용도를 합쳐 신고한다. Meta 로 가는 건 CompleteRegistration 하나뿐이고
             알약·타이머 등 제품 이벤트는 보내지 않는다(MetaAdsService 주석). -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeProductInteraction</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <true/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
                <string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
            </array>
        </dict>
        <!-- Crashlytics = 크래시 데이터(앱 기능) -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeCrashData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- IDFA = 기기 식별자. Meta 광고 어트리뷰션 전용이며 **ATT 동의 시에만** 수집된다
             (거부하면 SKAdNetwork 집계로만 간다).

             이 항목은 원래 Keychain 기기 UUID 용이었는데 그건 NM-410 클린 컷오버로 사라졌다.
             같은 데이터 유형이 다른 이유로 되살아난 것이라, 용도를 광고로 바꿔 적는다. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <true/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
            </array>
        </dict>
    </array>

    <!-- 앱 자체 코드가 호출하는 필수 사유(Required Reason) API. SDK는 각자 매니페스트로 선언. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- UserDefaults: 앱·앱그룹(group.app.nursemate.timer) 공유 저장. 위젯·워치·AlarmKit 인텐트가 같은 suite 공유. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
