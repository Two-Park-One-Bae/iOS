#include "Secrets.xcconfig"

CODE_SIGN_STYLE = Automatic
ENABLE_USER_SCRIPT_SANDBOXING = NO
SWIFT_EMIT_LOC_STRINGS = YES
BASE_URL = $(BASE_URL_RELEASE)
// 외부 테스터·프로덕션은 Firebase Analytics 자동수집 ON (NM-364). 내부 TestFlight는 beta_internal 레인이 NO로 덮어씀.
FIREBASE_ANALYTICS_ENABLED = YES

// 번들에 넣을 GoogleService-Info.plist 를 고른다 (Firebase/<값>/).
FIREBASE_ENV = Release
