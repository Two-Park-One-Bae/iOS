#include "Secrets.xcconfig"

CODE_SIGN_STYLE = Automatic
ENABLE_USER_SCRIPT_SANDBOXING = NO
SWIFT_EMIT_LOC_STRINGS = YES
BASE_URL = $(BASE_URL_DEBUG)
// 구글 로그인 복귀 URL 스킴 (NM-410). dev/prod Firebase 프로젝트마다 값이 다르다.
//
// **빌드 구성이 아니라 `FIREBASE_ENV` 를 따라간다.** 이 스킴은 번들에 들어가는
// GoogleService-Info.plist 의 CLIENT_ID 와 **반드시 짝이어야** 하고, 그 plist 를 고르는 값이
// 바로 `FIREBASE_ENV` 이기 때문이다. 구성에 묶어 두면 레인이 `FIREBASE_ENV` 만 덮었을 때
// plist 는 dev 인데 스킴은 prod 로 남아, GIDSignIn 이 "이 clientID 에 맞는 URL 스킴이 없다"며
// 예외를 던지고 앱이 죽는다(NM-422 — beta_internal 이 Release 빌드에 dev Firebase 를 쓴다).
GOOGLE_REVERSED_CLIENT_ID = $(GOOGLE_REVERSED_CLIENT_ID_$(FIREBASE_ENV:upper))
// Firebase Analytics 자동수집 ON — dev 프로젝트로 수집되므로 운영 속성은 오염되지 않는다.
// DebugView·실시간 보고서로 계측을 출시 전에 검증하기 위함 (NM-364 의 전제였던 단일 프로젝트 구성이 해소됨).
FIREBASE_ANALYTICS_ENABLED = YES

// 번들에 넣을 GoogleService-Info.plist 를 고른다 (Firebase/<값>/).
// 개발 환경은 dev Firebase 프로젝트(nursemate-dev)를 쓴다 — 운영 Crashlytics·App Check 와 분리.
FIREBASE_ENV = Debug
